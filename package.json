{
  "name": "evadence",
  "version": "0.1.0",
  "private": true,
  "description": "EVAdence — real NASA climate data for the classroom (NASA Space Apps 2026 · Earth System Trend Detective)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "preview": "npx --yes serve dist",
    "start": "node --env-file-if-exists=.env.local scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "engines": { "node": "22.x" }
}
