{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/demo/join",
      "destination": "/demo/join/index.html"
    },
    {
      "source": "/demo/join/",
      "destination": "/demo/join/index.html"
    },
    {
      "source": "/demo",
      "destination": "/demo/index.html"
    },
    {
      "source": "/demo/",
      "destination": "/demo/index.html"
    }
  ]
}
